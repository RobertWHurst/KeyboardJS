{
  "name": "keyboardjs",
  "description": "A library for binding to keys and key combos without the pain of key codes and key combo conflicts.",
  "version": "2.8.1",
  "main": "dist/keyboard.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./dist/keyboard.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./dist/keyboard.js"
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./dist/keyboard.js"
      }
    },
    "./index": "./index.js",
    "./lib/keyboard": "./lib/keyboard.js",
    "./lib/key-combo": "./lib/key-combo.js",
    "./lib/locale": "./lib/locale.js",
    "./locales/us": "./locales/us.js",
    "./dist/keyboard": {
      "import": {
        "types": "./index.d.mts",
        "default": "./dist/keyboard.mjs"
      },
      "require": {
        "types": "./dist/keyboard.d.ts",
        "default": "./dist/keyboard.js"
      },
      "default": {
        "types": "./dist/keyboard.d.ts",
        "default": "./dist/keyboard.js"
      }
    },
    "./dist/keyboard.js": {
      "import": {
        "types": "./index.d.mts",
        "default": "./dist/keyboard.mjs"
      },
      "require": {
        "types": "./dist/keyboard.d.ts",
        "default": "./dist/keyboard.js"
      },
      "default": {
        "types": "./dist/keyboard.d.ts",
        "default": "./dist/keyboard.js"
      }
    },
    "./dist/keyboard.min": {
      "types": "./dist/keyboard.min.d.ts",
      "default": "./dist/keyboard.min.js"
    },
    "./dist/keyboard.min.js": {
      "types": "./dist/keyboard.min.d.ts",
      "default": "./dist/keyboard.min.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "test": "mocha -r ./test/setup.js test/**/*.spec.js",
    "build": "rollup --config",
    "test:types": "tsc -p test/types",
    "test:compat": "node test/compat/run.cjs"
  },
  "keywords": [
    "Key Binding, Keyboard, Key combos, Keyboard Shortcuts"
  ],
  "author": "Robert Hurst <robertwhurst@gmail.com>",
  "bugs": {
    "url": "https://github.com/RobertWHurst/KeyboardJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:RobertWHurst/KeyboardJS.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.10.2",
    "@babel/preset-env": "^7.10.2",
    "@babel/register": "~7.10.5",
    "@rollup/plugin-babel": "^5.0.2",
    "mocha": "^7.2.0",
    "rollup": "^2.13.1",
    "rollup-plugin-terser": "^6.1.0",
    "sinon": "^9.0.2",
    "typescript": "^5.0.0"
  }
}
